{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kvmate",
  "identifier": "dev.pawelduraj.kvmate",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "KVM for keyboard, mouse, sound and microphone across two computers",
    "category": "Utility"
  }
}
